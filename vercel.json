{
    "functions": {
      "api/blogs/index.js": {
        "includeFiles": "blogs.json"
      },
      "api/blogs/[id].js": {
        "includeFiles": "blogs.json"
      },
      "api/blogs/[id]/comments.js": {
        "includeFiles": "blogs.json"
      },
      "api/blogs/admin/auth.js": {
        "includeFiles": "blogs.json"
      },
      "api/blogs/admin/credentials.js": {
        "includeFiles": "blogs.json"
      }
    },
    "redirects": [
      { "source": "/blog/admin", "destination": "/admin", "permanent": false },
      { "source": "/blog/dashboard", "destination": "/admin/dashboard", "permanent": false },
      { "source": "/findatime/admin", "destination": "/admin/dashboard?panel=findatime-panel", "permanent": false },
      { "source": "/findatime/admin/", "destination": "/admin/dashboard?panel=findatime-panel", "permanent": false }
    ],
    "headers": [
      {
        "source": "/admin",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      },
      {
        "source": "/admin/dashboard",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      },
      {
        "source": "/blog/admin",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      },
      {
        "source": "/blog/dashboard",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/mcp", "destination": "/api/findatime?operation=mcp" },
      { "source": "/api/findatime/visit", "destination": "/api/findatime?operation=visit" },
      { "source": "/admin", "destination": "/blog-admin.html" },
      { "source": "/admin/dashboard", "destination": "/blog-dashboard.html" },
      { "source": "/blog/:slug", "destination": "/blog.html" },
      { "source": "/blog", "destination": "/blog.html" },
      { "source": "/findatime", "destination": "/findatime/index.html" },
      { "source": "/findatime/uuid/:id", "destination": "/findatime/index.html" }
    ]
}
